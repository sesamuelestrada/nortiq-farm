# ============================================================
# Synopsis Farm — Variables de Entorno
# Copiar a .env.local y llenar los valores
# NUNCA commitear .env.local
# ============================================================

# Supabase (requerido — https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — Claude agent para voice input (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI — Whisper transcripción de voz (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# ============================================================
# FUTURO: WhatsApp (WOW Moment #1 — no implementado en PoC)
# ============================================================
# Twilio WhatsApp Sandbox (https://console.twilio.com/)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
